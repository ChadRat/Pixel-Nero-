<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rainbow Droplet - Inner Shadow / Base Glow for depth -->
    <path
        android:pathData="M 54,16 C 54,16 22,50 22,72 C 22,90 36,100 54,100 C 72,100 86,90 86,72 C 86,50 54,16 54,16 Z"
        android:fillColor="#15FFFFFF" />

    <!-- Left Ribbon Segment: Cyan to Blue to Violet to Purple -->
    <path
        android:pathData="M 54,16
                    C 46,26 36,38 31,51
                    C 26,64 24,76 29,86
                    C 34,96 46,98 54,98
                    C 54,98 44,92 38,82
                    C 32,72 32,60 38,48
                    C 44,36 50,26 54,16 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="16"
                android:endX="30"
                android:endY="98">
                <item android:color="#00F0FF" android:offset="0.0" />  <!-- Bright Cyan -->
                <item android:color="#0066FF" android:offset="0.4" />  <!-- Vibrant Blue -->
                <item android:color="#7A00FF" android:offset="0.8" />  <!-- Deep Purple -->
                <item android:color="#BD00FF" android:offset="1.0" />  <!-- Violet-Magenta -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Ribbon Segment: Green to Lime to Yellow to Orange -->
    <path
        android:pathData="M 54,16
                    C 62,26 72,38 77,51
                    C 82,64 84,76 79,86
                    C 74,96 62,98 54,98
                    C 54,98 64,92 70,82
                    C 76,72 76,60 70,48
                    C 64,36 58,26 54,16 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="16"
                android:endX="78"
                android:endY="98">
                <item android:color="#00FF66" android:offset="0.0" />  <!-- Neon Green -->
                <item android:color="#ADFF00" android:offset="0.3" />  <!-- Lime -->
                <item android:color="#FFEA00" android:offset="0.6" />  <!-- Electric Yellow -->
                <item android:color="#FF7A00" android:offset="0.85" /> <!-- Orange -->
                <item android:color="#FF003C" android:offset="1.0" />  <!-- Coral Red -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Overlapping Central/Bottom Twist Segment (Creates the ribbon illusion and hollow center) -->
    <path
        android:pathData="M 38,48
                    C 44,36 50,26 54,16
                    C 58,26 64,36 70,48
                    C 76,60 76,72 70,82
                    C 64,92 54,98 54,98
                    C 54,98 44,92 38,82
                    C 32,72 32,60 38,48 Z"
        android:fillColor="#FFFFFF" />  <!-- Hollow inner center matching background -->

    <!-- Glow/Reflections overlays for that 3D glossy satin look -->
    <path
        android:pathData="M 54,20 C 51,28 45,38 41,50 C 37,62 36,70 40,78 C 36,74 34,64 38,52 C 42,40 48,30 54,20 Z"
        android:fillColor="#40FFFFFF" />

    <path
        android:pathData="M 54,20 C 57,28 63,38 67,50 C 71,62 72,70 68,78 C 72,74 74,64 70,52 C 66,40 60,30 54,20 Z"
        android:fillColor="#20FFFFFF" />

</vector>
